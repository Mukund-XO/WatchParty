# Firebase web app settings. Copy this file to .env.local and fill in the values from
#   Firebase console > Project settings > General > Your apps > Web app > SDK setup and configuration
#
# These identify your project and are meant to be public: every Firebase web app ships them to
# every visitor. Security comes from database.rules.json, not from hiding them. Do restrict the
# API key to your own website addresses (see README, "Lock down the API key").
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# Realtime Database URL, e.g. https://your-project-default-rtdb.firebaseio.com
# or https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development against the Firebase emulators (no real project needed). Run
# `npm run emulators` in one terminal and `npm run dev` in another. Production builds ignore this.
# VITE_USE_FIREBASE_EMULATORS=true

# Never put a secret here. Anything in this file that starts with VITE_ is bundled into the page.
